# Используем те же переменные, что и в typeorm.config.ts
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=admin 
POSTGRES_PASSWORD=admin 
POSTGRES_DB=SkillSwapDB_test 

# Настройки для автоматической очистки/синхронизации схемы
DROP_SCHEMA=true
TYPEORM_SYNCHRONIZE=true

# JWT настройки (если используются в seed-users или напрямую в тестах)
JWT_SECRET=your_test_secret_key_for_jwt
AUTH_ACCESS_TOKEN_EXPIRY=3600s # Или JWT_EXPIRES_IN=3600s, если так ожидается в коде